# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# SCDSS_JWT_SECRET: Secret key used to sign HMAC-SHA256 authentication tokens.
SCDSS_JWT_SECRET="replace-with-production-hmac-secret"

# SCDSS_DB_PATH: Optional custom path for the SQLite database file (defaults to ./data/scdss.db)
# SCDSS_DB_PATH="./data/scdss.db"
